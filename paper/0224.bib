	pages = {124589},
	file = {Cheng et al. - 2024 - Deep reinforcement learning driven cost minimization for batch order scheduling in robotic mobile fu.pdf:/Users/siwenliu/Desktop/review/2.1/Cheng et al. - 2024 - Deep reinforcement learning driven cost minimization for batch order scheduling in robotic mobile fu.pdf:application/pdf},
}

@article{zhang_deep_2024-1,
