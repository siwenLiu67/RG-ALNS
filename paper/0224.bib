	file = {Lu et al. - 2024 - A Double Deep Q-Network framework for a flexible job shop scheduling problem with dynamic job arriva.pdf:/Users/siwenliu/Desktop/review/2.2/Lu et al. - 2024 - A Double Deep Q-Network framework for a flexible job shop scheduling problem with dynamic job arriva.pdf:application/pdf},
